{
  "name": "@salilvnair/dui",
  "version": "1.0.15",
  "description": "Daakia UI component library \u2014 shared across ck8t and daakia",
  "type": "module",
  "license": "MIT",
  "author": "Salil V Nair",
  "homepage": "https://github.com/salilvnair/dui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salilvnair/dui.git"
  },
  "bugs": {
    "url": "https://github.com/salilvnair/dui/issues"
  },
  "keywords": [
    "react",
    "component-library",
    "ui",
    "design-system",
    "tailwind",
    "monaco-editor",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./monaco-setup": {
      "types": "./dist/monaco-setup.d.ts",
      "import": "./dist/monaco-setup.js"
    },
    "./vis-setup": {
      "types": "./dist/vis-setup.d.ts",
      "import": "./dist/vis-setup.js"
    },
    "./style.css": "./dist/style.css",
    "./theme/core": {
      "types": "./dist/lib/theme/core.d.ts",
      "import": "./dist/theme/core.js"
    },
    "./theme/utils": {
      "types": "./dist/lib/theme/utils.d.ts",
      "import": "./dist/theme/utils.js"
    },
    "./theme/editor": {
      "types": "./dist/lib/theme/editor.d.ts",
      "import": "./dist/theme/editor.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/vis-setup.js",
    "./dist/monaco-setup.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --outDir demo-dist",
    "build:lib": "vite build --config vite.publish.config.ts",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "shots": "node scripts/screenshots/capture.mjs",
    "shots:light": "node scripts/screenshots/capture.mjs --theme light --no-hero",
    "sheets": "node scripts/screenshots/sheets.mjs",
    "catalog": "node scripts/screenshots/readme-catalog.mjs",
    "catalog:check": "node scripts/screenshots/readme-catalog.mjs --check",
    "coverage": "node scripts/showcase/coverage.mjs",
    "coverage:check": "node scripts/showcase/coverage.mjs --check",
    "demo-video:record": "node scripts/demo-video/record.js",
    "demo-video:compose": "node scripts/demo-video/compose.js",
    "demo-video:refine": "node scripts/demo-video/refine.js",
    "demo-video:gif": "node scripts/demo-video/gif.js",
    "demo-video:gif:short": "node scripts/demo-video/gif.js --highlights",
    "demo-video": "npm run demo-video:record && npm run demo-video:compose",
    "showcase": "npm run demo-video && npm run demo-video:refine && npm run demo-video:gif:short && npm run demo-video:publish",
    "demo-video:publish": "node scripts/demo-video/publish.js"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "marked": "^14.0.0"
  },
  "peerDependencies": {
    "@monaco-editor/react": ">=4",
    "monaco-editor": ">=0.50",
    "react": ">=18",
    "react-dom": ">=18",
    "vis-data": ">=7",
    "vis-network": ">=9",
    "zustand": ">=4"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    },
    "vis-data": {
      "optional": true
    },
    "vis-network": {
      "optional": true
    }
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.63.0",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vis-data": "^7.1.10",
    "vis-network": "^9.1.13",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
